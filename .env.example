# MOTUS environment configuration — copy to .env and adjust.
# This file contains placeholders ONLY. Never commit real secrets.

# --- Database (required) ----------------------------------------------------
# SQLite database file used by Prisma for analysis-run history and the
# reference registry. The default matches the committed setup:
DATABASE_URL="file:../db/custom.db"

# --- NASA Earthdata (optional, credential-gated datasets) --------------------
# A NASA Earthdata Login bearer token (JWT), used ONLY by
# tools/fetch_nisar_granule.py to download operational NISAR products from the
# ASF Earthdata Cloud. The web application itself never requires it: without a
# token, the credential-gated datasets simply report state 'missing' with
# acquisition instructions.
#
# Obtain a free account at https://urs.earthdata.nasa.gov/ and generate a
# token via the Earthdata profile UI ("Generate Token").
# EARTHDATA_BEARER_TOKEN="eyJhbGciOi...your-token..."
